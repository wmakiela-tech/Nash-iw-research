{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wmakiela-tech/Nash-iw-research/archive-index/archive-entry.schema.json",
  "title": "NASH/IW public archive entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "canonical_filename", "archive_mode", "document_type", "created_at", "origin_cell", "exposure", "status", "provenance"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^IW_[A-Z0-9][A-Z0-9_-]*_[0-9]{3}_[0-9]{8}$"},
    "canonical_filename": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "archive_mode": {"enum": ["PUBLIC_ARTIFACT", "POINTER_ONLY", "HASH_ONLY", "EXECUTABLE_REPRODUCTION"]},
    "document_type": {"enum": ["TASK", "PACKET", "RETURN", "REVIEW", "DECISION", "MANIFEST", "REPORT", "DATA", "SCHEMA", "INDEX"]},
    "created_at": {"type": "string", "format": "date"},
    "as_of": {"type": "string"},
    "origin_cell": {"type": "string", "minLength": 1},
    "owner": {"type": "string"},
    "exposure": {"enum": ["PUBLIC", "PRIVATE", "RESTRICTED"]},
    "status": {"enum": ["DRAFT", "CURRENT", "FROZEN", "SUPERSEDED", "RETRACTED", "HOLD"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {"type": "string", "minLength": 1},
    "retrieval": {"type": "string"},
    "derived_from": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"archive_mode": {"const": "HASH_ONLY"}}},
      "then": {"required": ["sha256"]}
    },
    {
      "if": {"properties": {"exposure": {"const": "PUBLIC"}}},
      "then": {},
      "else": {"not": {"properties": {"archive_mode": {"enum": ["PUBLIC_ARTIFACT", "EXECUTABLE_REPRODUCTION"]}}}}
    }
  ]
}
